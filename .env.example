# Agent Builder — all optional; names only, never values in git.
GITHUB_TOKEN=            # fine-grained PAT: new agents get their own repo; READ on the view repo
ARCHITECT_ADVISOR=       # name of the registered outbound A2A endpoint for the hosted Architect (/subscribe)
ARCHITECT_FLEET=         # fleet slug — the <fleet> in views/<fleet>/target-view.yaml
ARCHITECT_VIEW_SOURCE=   # git:github:<org>/<repo>  or  local:views/<fleet>/target-view.yaml (default)
